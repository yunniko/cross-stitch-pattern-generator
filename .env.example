# Local dev: `docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db`, then this URL.
DATABASE_URL="postgresql://cross_stitch:cross_stitch@127.0.0.1:54324/cross_stitch"

# Production only: the database password (docker-compose.yml). Unset, the local default is used.
# Generate with: openssl rand -hex 24
# DB_PASSWORD=""

# The site's address for Auth.js (production); APP_URL is used when unset.
# AUTH_URL="https://cross-stitch.craftodejnice.cz"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Auth.js trusts the Host header only when this is set -- needed once the app sits behind nginx (D245).
AUTH_TRUST_HOST="true"

# The account with this email is promoted to ADMIN at first sign-in (first-admin bootstrap; further admins
# are promoted from /admin/users once that one exists). Set ADMIN_BOOTSTRAP_ENABLED="false" once it does --
# left "true" while email is off (below), anyone who registers this address becomes an admin, since no address
# is confirmed then.
ADMIN_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_ENABLED="true"

# Email (G-113, D342). Off unless MAIL_TRANSPORT, MAIL_FROM and the site's address (AUTH_URL or APP_URL) are all set;
# off, nothing is sent, registering signs in at once, and an address needs no confirming.
# MAIL_TRANSPORT="resend"            # or "file": each message written to MAIL_OUTBOX_DIR, nothing leaves the machine
# MAIL_FROM="Cross-Stitch Pattern Generator <no-reply@example.com>"
# RESEND_API_KEY=""
# MAIL_OUTBOX_DIR="mail-outbox"

# How often a signed-in session re-reads its account (D335, D345): a disabled account, a changed role or a password
# reset takes effect within this. 300 seconds when unset; the e2e suite uses 0.
# ACCOUNT_RECHECK_SECONDS=300

# Rate limits (lib/server/request-guard.ts). Defaults: 6 job requests/minute, 8 auth attempts/15 minutes.
# The e2e suite overrides these to drive the app far faster than a person would.
# RATE_LIMIT_JOBS_PER_MINUTE=6
# RATE_LIMIT_AUTH_PER_15MIN=8
# RATE_LIMIT_AUTH_ACCOUNT_PER_15MIN=20
# RATE_LIMIT_PREDICTIONS_PER_MINUTE=90
# RATE_LIMIT_DITHER_PREVIEWS_PER_MINUTE=90
# RATE_LIMIT_MAIL_PER_HOUR=5   # messages to one address

# How long a browser keeps its feature states before asking for them again (G-102). 5 to 86400 seconds; 300 when unset.
# FEATURES_REFRESH_SECONDS=300
