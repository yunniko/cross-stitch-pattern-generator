{
  "name": "cross-stitch-pattern-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "generate-test-fixture": "node scripts/generate-test-fixture.mjs",
    "bench:browser": "playwright test --config scripts/playwright.bench.config.ts",
    "bench:chart": "playwright test --config scripts/playwright.bench-chart.config.ts",
    "bench:move": "playwright test --config scripts/playwright.bench-move.config.ts",
    "compare:screen": "playwright test --config scripts/playwright.screen-compare.config.ts",
    "compare:exports": "playwright test --config scripts/playwright.export-compare.config.ts",
    "build:processor": "node scripts/build-processor.mjs",
    "compare:export-parity": "playwright test --config scripts/playwright.export-parity.config.ts",
    "test:goldens:rust": "vitest run --config vitest.rust.config.ts scripts/rust-goldens.ts",
    "test:backstitch:rust": "vitest run --config vitest.rust.config.ts scripts/rust-backstitch-oxs.ts",
    "test:backstitch-style:rust": "vitest run --config vitest.rust.config.ts scripts/rust-backstitch-style.ts",
    "test:photo-adjust:rust": "vitest run --config vitest.rust.config.ts scripts/rust-photo-adjust.ts",
    "test:enhancement:rust": "vitest run --config vitest.rust.config.ts scripts/rust-enhancement-gates.ts",
    "test:enhance-parity:rust": "vitest run --config vitest.rust.config.ts scripts/rust-enhance-parity.ts",
    "test:processor:rust": "vitest run --config vitest.rust.config.ts tests/unit/processor-export-pool.spec.ts tests/unit/processor-pool-limits.spec.ts tests/unit/processor-pool-parity.spec.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "color-name-list": "^14.49.0",
    "jszip": "^3.10.2",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.9",
    "rolldown": "^1.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
