{
  "name": "cross-stitch-pattern-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "generate-test-fixture": "node scripts/generate-test-fixture.mjs",
    "bench": "vitest run --config vitest.bench.config.ts",
    "bench:browser": "playwright test --config scripts/playwright.bench.config.ts",
    "bench:chart": "playwright test --config scripts/playwright.bench-chart.config.ts",
    "bench:move": "playwright test --config scripts/playwright.bench-move.config.ts",
    "compare:screen": "playwright test --config scripts/playwright.screen-compare.config.ts",
    "compare:exports": "playwright test --config scripts/playwright.export-compare.config.ts",
    "calibrate:enhancement": "vitest run --config vitest.calibrate.config.ts",
    "build:processor": "node scripts/build-processor.mjs",
    "compare:export-parity": "playwright test --config scripts/playwright.export-parity.config.ts",
    "compare:rust": "vitest run --config vitest.rust.config.ts scripts/rust-parity.ts",
    "compare:dither": "vitest run --config vitest.rust.config.ts scripts/dither-comparison.ts",
    "compare:vivid": "vitest run --config vitest.rust.config.ts scripts/vivid-comparison.ts",
    "samples:hand-drawn": "vitest run --config vitest.rust.config.ts scripts/hand-drawn-samples.ts",
    "shapes:hand-drawn": "vitest run --config vitest.rust.config.ts scripts/hand-drawn-shapes.ts",
    "compare:rust-exports": "vitest run --config vitest.rust.config.ts scripts/rust-export-parity.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "color-name-list": "^14.49.0",
    "jszip": "^3.10.2",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.9",
    "rolldown": "^1.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
