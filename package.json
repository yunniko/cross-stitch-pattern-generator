{
  "name": "cross-stitch-pattern-generator",
  "version": "0.28.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --grep-invert @alone && playwright test --grep @alone --workers=1",
    "e2e:servers": "node scripts/e2e-servers.mjs",
    "e2e:dev": "node scripts/e2e-servers.mjs --dev",
    "check:skin": "node scripts/check-skin.mjs",
    "check:fast": "tsc --noEmit && vitest run --changed && eslint --cache && prettier --check --cache --log-level warn . && node scripts/check-skin.mjs && node scripts/check-reachable.mjs && npm run check:brief --silent && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-release-notes.mjs",
    "release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/release.mjs",
    "launch:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/launch-check.mjs",
    "check:brief": "node scripts/design-brief-coverage.mjs && node scripts/design-brief-words.mjs",
    "check:reachable": "node scripts/check-reachable.mjs",
    "check:release-notes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-release-notes.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "generate-test-fixture": "node scripts/generate-test-fixture.mjs",
    "bench:browser": "playwright test --config scripts/playwright.bench.config.ts",
    "bench:chart": "playwright test --config scripts/playwright.bench-chart.config.ts",
    "bench:move": "playwright test --config scripts/playwright.bench-move.config.ts",
    "compare:screen": "playwright test --config scripts/playwright.screen-compare.config.ts",
    "build:processor": "node scripts/build-processor.mjs",
    "dither-previews": "cargo run --release --manifest-path rust/Cargo.toml -p cs-bench -- dither-previews public/dither-previews",
    "dither-patterns": "cargo run --release --manifest-path rust/Cargo.toml -p cs-bench -- dither-patterns lib/pipeline/dither-patterns.ts",
    "test:goldens:rust": "vitest run --config vitest.rust.config.ts scripts/rust-goldens.ts",
    "test:backstitch:rust": "vitest run --config vitest.rust.config.ts scripts/rust-backstitch-oxs.ts",
    "test:backstitch-style:rust": "vitest run --config vitest.rust.config.ts scripts/rust-backstitch-style.ts",
    "test:canvas:rust": "vitest run --config vitest.rust.config.ts scripts/rust-canvas.ts",
    "test:stitch-texture:rust": "vitest run --config vitest.rust.config.ts scripts/rust-stitch-texture.ts",
    "test:photo-adjust:rust": "vitest run --config vitest.rust.config.ts scripts/rust-photo-adjust.ts",
    "test:photo-adjust-pipeline:rust": "vitest run --config vitest.rust.config.ts scripts/rust-photo-adjust-pipeline.ts",
    "test:processor:rust": "vitest run --config vitest.rust.config.ts tests/unit/processor-export-pool.spec.ts tests/unit/processor-job-kill.spec.ts tests/unit/processor-pool-limits.spec.ts tests/unit/processor-pool-parity.spec.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "color-name-list": "^14.49.0",
    "jszip": "^3.10.2",
    "marked": "^18.1.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.8",
    "stripe": "22.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "rolldown": "^1.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
