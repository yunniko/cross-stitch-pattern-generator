// Accounts (G-075). NextAuth's Prisma adapter dictates the shape of Account/Session/VerificationToken;
// everything else is this project's own. Generated client goes to `generated/prisma` (gitignored),
// matching `@/generated/prisma/client` under this project's `@/* -> ./*` path alias.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  /// Null for an account with no password set (there is no OAuth provider yet, but the adapter shape
  /// allows for one later without a migration).
  passwordHash      String?
  role              Role      @default(USER)
  /// A plain "can this account log in" switch (G-075 constraint: no ban reasons/expiry here, matching
  /// "simple personal cabinet" in the ask). An admin flips it; `authorize()` refuses sign-in while set.
  disabled          Boolean   @default(false)
  /// Sessions signed in before this moment are ended at their next account recheck (G-113, D345): set when the
  /// password is reset through a mailed link. Null means no session has been ended this way.
  sessionsValidFrom DateTime?
  /// When a session of this account last re-read it, or signed in (G-107 M3): to the five minutes of the recheck, not
  /// each request. Null for an account not seen since this was kept.
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  features     UserFeature[]

  @@index([role])
}

// Account / Session / VerificationToken follow the Auth.js Prisma adapter shape:
// https://authjs.dev/getting-started/adapters/prisma
// Session rows are written by the adapter but not read at request time — this project uses JWT
// sessions (see auth.ts) — kept because the adapter's type contract expects the model to exist.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Empty scaffolding for the future billing goal (G-075 constraints, 2026-09-27): admin-editable rows
/// rather than a hardcoded enum, since the tiers/limits themselves are not decided yet. Nothing reads
/// or writes this table in G-075 — it exists only so that goal is a data migration, not a schema rework.
model Tier {
  id            String   @id @default(cuid())
  name          String   @unique
  stripePriceId String?
  /// Whatever a tier unlocks, shaped once the product decision is made.
  limits        Json?
  /// The feature set a person on this tier gets (G-102); null means the site's states alone.
  featureSetId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  featureSet    FeatureSet?    @relation(fields: [featureSetId], references: [id])
}

/// Feature switches (G-102, D303). A feature's id is the feature list's (`app/features/registry.ts`); a row naming a
/// feature that no longer exists is ignored, never an error. A feature with no row is on.
enum FeatureSwitch {
  ON
  LOCKED
  HIDDEN
}

/// The state of a feature for the whole site.
model FeatureState {
  featureId String        @id
  state     FeatureSwitch
  updatedAt DateTime      @updatedAt
  /// Who set it, for the admin's record.
  updatedBy String?
}

/// The state of a feature for one person, which wins over the tier's set and the site.
model UserFeature {
  userId    String
  featureId String
  state     FeatureSwitch
  updatedAt DateTime      @updatedAt
  updatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, featureId])
}

/// A named set of states, for a tier to point at. A feature not in the set follows the site.
model FeatureSet {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries   FeatureSetEntry[]
  tiers     Tier[]
  audiences AudienceSet[]
}

/// The feature set every guest, or every signed-in account, gets (G-102, D307): `audience` is "guests" or "accounts".
/// It sits between the site and a tier: person > tier's set > this > site.
model AudienceSet {
  audience     String   @id
  featureSetId String
  updatedAt    DateTime @updatedAt

  set FeatureSet @relation(fields: [featureSetId], references: [id])
}

model FeatureSetEntry {
  setId     String
  featureId String
  state     FeatureSwitch

  set FeatureSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([setId, featureId])
}

/// Same scaffolding note as `Tier`. One subscription per user; `status` mirrors Stripe's own
/// subscription status strings so the future webhook can write it through unchanged.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  tierId               String
  status               String
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier Tier @relation(fields: [tierId], references: [id])
}

/// Usage counts for the admin stats page (G-075 M4): one row per generation or export job, written
/// best-effort from the Route Handlers that already front the processor. No photo bytes, no export
/// content — a count is all the admin page needs.
model UsageEvent {
  id         String    @id @default(cuid())
  kind       UsageKind
  userId     String?
  /// What an export was (`ExportJobKind`: "a4-color", "all", ...); null for a generation, and for an export recorded
  /// before G-107 M2 began keeping it.
  exportKind String?
  createdAt  DateTime  @default(now())

  @@index([kind, createdAt])
  @@index([userId, createdAt])
}

enum UsageKind {
  GENERATE
  EXPORT
}

/// Every change an admin makes (G-102 M3; role and login changes too since G-107 M3, D348): who, when, what.
/// Append-only; the admin's Change log shows it, and the Features page its feature changes.
model FeatureChange {
  id        String   @id @default(cuid())
  /// SITE, USER, SET, TIER or AUDIENCE for the switches; ACCOUNT for a role or a login (`lib/admin/change-log.ts`).
  scope     String
  /// The user id, the set id or the tier id the change was to; empty for the site.
  subject   String   @default("")
  /// What is now true, in words: "tool.text → locked", "set Starter attached".
  change    String
  byUserId  String
  byEmail   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([scope, createdAt])
}
