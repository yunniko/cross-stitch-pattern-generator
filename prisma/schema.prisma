// Accounts (G-075). NextAuth's Prisma adapter dictates the shape of Account/Session/VerificationToken;
// everything else is this project's own. Generated client goes to `generated/prisma` (gitignored),
// matching `@/generated/prisma/client` under this project's `@/* -> ./*` path alias.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  /// Null for an account with no password set (there is no OAuth provider yet, but the adapter shape
  /// allows for one later without a migration).
  passwordHash  String?
  role          Role      @default(USER)
  /// A plain "can this account log in" switch (G-075 constraint: no ban reasons/expiry here, matching
  /// "simple personal cabinet" in the ask). An admin flips it; `authorize()` refuses sign-in while set.
  disabled      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?

  @@index([role])
}

// Account / Session / VerificationToken follow the Auth.js Prisma adapter shape:
// https://authjs.dev/getting-started/adapters/prisma
// Session rows are written by the adapter but not read at request time — this project uses JWT
// sessions (see auth.ts) — kept because the adapter's type contract expects the model to exist.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Empty scaffolding for the future billing goal (G-075 constraints, 2026-09-27): admin-editable rows
/// rather than a hardcoded enum, since the tiers/limits themselves are not decided yet. Nothing reads
/// or writes this table in G-075 — it exists only so that goal is a data migration, not a schema rework.
model Tier {
  id            String   @id @default(cuid())
  name          String   @unique
  stripePriceId String?
  /// Whatever a tier unlocks, shaped once the product decision is made.
  limits        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

/// Same scaffolding note as `Tier`. One subscription per user; `status` mirrors Stripe's own
/// subscription status strings so the future webhook can write it through unchanged.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  tierId               String
  status               String
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier Tier @relation(fields: [tierId], references: [id])
}

/// Usage counts for the admin stats page (G-075 M4): one row per generation or export job, written
/// best-effort from the Route Handlers that already front the processor. No photo bytes, no export
/// content — a count is all the admin page needs.
model UsageEvent {
  id        String   @id @default(cuid())
  kind      UsageKind
  userId    String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

enum UsageKind {
  GENERATE
  EXPORT
}
