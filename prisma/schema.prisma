// Accounts (G-075). NextAuth's Prisma adapter dictates the shape of Account/Session/VerificationToken;
// everything else is this project's own. Generated client goes to `generated/prisma` (gitignored),
// matching `@/generated/prisma/client` under this project's `@/* -> ./*` path alias.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  /// Null for an account with no password set (there is no OAuth provider yet, but the adapter shape
  /// allows for one later without a migration).
  passwordHash      String?
  role              Role      @default(USER)
  /// A plain "can this account log in" switch (G-075 constraint: no ban reasons/expiry here, matching
  /// "simple personal cabinet" in the ask). An admin flips it; `authorize()` refuses sign-in while set.
  disabled          Boolean   @default(false)
  /// Sessions signed in before this moment are ended at their next account recheck (G-113, D345): set when the
  /// password is reset through a mailed link. Null means no session has been ended this way.
  sessionsValidFrom DateTime?
  /// When a session of this account last re-read it, or signed in (G-107 M3): to the five minutes of the recheck, not
  /// each request. Null for an account not seen since this was kept.
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  consents     PurchaseConsent[]
  features     UserFeature[]
  limits       UserLimit[]
  charts       SavedChart[]
  stamps       Stamp[]

  @@index([role])
}

// Account / Session / VerificationToken follow the Auth.js Prisma adapter shape:
// https://authjs.dev/getting-started/adapters/prisma
// Session rows are written by the adapter but not read at request time — this project uses JWT
// sessions (see auth.ts) — kept because the adapter's type contract expects the model to exist.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Empty scaffolding for the future billing goal (G-075 constraints, 2026-09-27): admin-editable rows
/// rather than a hardcoded enum, since the tiers/limits themselves are not decided yet. Nothing reads
/// or writes this table in G-075 — it exists only so that goal is a data migration, not a schema rework.
model Tier {
  id              String   @id @default(cuid())
  name            String   @unique
  /// The feature set a person on this tier gets (G-102); null means the site's states alone.
  featureSetId    String?
  /// The provider's product this tier's prices belong to (G-127): made with the tier's first price.
  stripeProductId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
  featureSet    FeatureSet?    @relation(fields: [featureSetId], references: [id])
  limits        TierLimit[]
  prices        Price[]
}

enum BillingInterval {
  MONTH
  YEAR
}

/// A price of a tier (G-106 M1): a row of its own, never edited in place. A changed price is a new row and the old one
/// stops being current; subscriptions already on the old price keep it (D368). Checkout offers only current rows.
model Price {
  id            String          @id @default(cuid())
  tierId        String
  interval      BillingInterval
  /// In the currency's minor unit (cents).
  amount        Int
  /// ISO 4217, lower case, as Stripe writes it ("eur").
  currency      String
  /// The price at Stripe this row stands for.
  stripePriceId String          @unique
  current       Boolean         @default(true)
  createdAt     DateTime        @default(now())

  tier          Tier           @relation(fields: [tierId], references: [id])
  subscriptions Subscription[]

  @@index([tierId, interval, current])
}

/// Feature switches (G-102, D303). A feature's id is the feature list's (`app/features/registry.ts`); a row naming a
/// feature that no longer exists is ignored, never an error. A feature with no row is on.
enum FeatureSwitch {
  ON
  LOCKED
  HIDDEN
}

/// The state of a feature for the whole site.
model FeatureState {
  featureId String        @id
  state     FeatureSwitch
  updatedAt DateTime      @updatedAt
  /// Who set it, for the admin's record.
  updatedBy String?
}

/// The state of a feature for one person, which wins over the tier's set and the site.
model UserFeature {
  userId    String
  featureId String
  state     FeatureSwitch
  updatedAt DateTime      @updatedAt
  updatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, featureId])
}

/// A named set of states, for a tier to point at. A feature not in the set follows the site.
model FeatureSet {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries   FeatureSetEntry[]
  tiers     Tier[]
  audiences AudienceSet[]
}

/// The feature set every guest, or every signed-in account, gets (G-102, D307): `audience` is "guests" or "accounts".
/// It sits between the site and a tier: person > tier's set > this > site.
model AudienceSet {
  audience     String   @id
  featureSetId String
  updatedAt    DateTime @updatedAt

  set FeatureSet @relation(fields: [featureSetId], references: [id])
}

model FeatureSetEntry {
  setId     String
  featureId String
  state     FeatureSwitch

  set FeatureSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([setId, featureId])
}

/// A person's subscription: the latest snapshot read from Stripe (G-106, D369), never pieced together from events. What
/// it gives is the entitlement rule's to say (`lib/billing/entitlement.ts`, D367).
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  /// "stripe" for a subscription bought at the provider; "grant" for one an admin gives by hand (G-127, D379), with no
  /// provider id, ending at `currentPeriodEnd`.
  kind                 String    @default("stripe")
  tierId               String
  /// The price subscribed to; null for a row not made through Checkout (tests, and G-127's grants by hand).
  priceId              String?
  /// Stripe's status, written through unchanged (`SUBSCRIPTION_STATUSES`).
  status               String
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  /// From the subscription's item: Stripe no longer keeps the period on the subscription itself.
  currentPeriodEnd     DateTime?
  /// The person cancelled in the Portal; the subscription ends at `currentPeriodEnd`.
  cancelAtPeriodEnd    Boolean   @default(false)
  endedAt              DateTime?
  /// The first failed attempt of the invoice now open, from Stripe's own dates; null when no invoice is failing.
  firstFailedAt        DateTime?
  /// While an invoice is failing: Stripe's next try, its page for paying it, and whether the bank waits on the person (G-126).
  nextAttemptAt        DateTime?
  payUrl               String?
  actionNeeded         Boolean   @default(false)
  /// When this snapshot was last read from Stripe.
  syncedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier     Tier                @relation(fields: [tierId], references: [id])
  price    Price?              @relation(fields: [priceId], references: [id])
  events   SubscriptionEvent[]
  notices  BillingNotice[]
  consents PurchaseConsent[]

  /// A dispute or refund names only the customer (G-126).
  @@index([stripeCustomerId])
}

/// The messages a failing renewal sends (G-126 M2, D377): queued in the sync's transaction, sent after it. One row per
/// failure and slot, so each is sent once however often the subscription is synced.
model BillingNotice {
  id             String    @id @default(cuid())
  subscriptionId String
  /// The failure the notice belongs to: its first failed attempt (D375).
  failedAt       DateTime
  /// "failed", "last", "free" or "recovered" (`NoticeSlot` in `lib/billing/notices.ts`).
  slot           String
  /// The message id (`NoticeMessage`), and what it is built from at delivery.
  message        String
  values         Json
  createdAt      DateTime  @default(now())
  /// When a delivery took it; null while it waits.
  sentAt         DateTime?
  attempts       Int       @default(0)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, failedAt, slot])
  @@index([sentAt, createdAt])
}

/// A Stripe event already handled (G-106): its id is recorded once, so a second delivery changes nothing. The payload
/// is not kept.
model BillingEvent {
  /// Stripe's event id ("evt_...").
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

/// When a scheduled billing pass last ran and whether it read everything (G-128 M3, D385): the launch check asks it.
/// One row per pass, overwritten each run.
model BillingRun {
  /// "reconcile".
  kind String   @id
  at   DateTime
  ok   Boolean
}

/// The history of a subscription (G-106; Architecture fit (4)): one row per change to its snapshot, append-only, as
/// `FeatureChange` is for features. G-127's admin page shows it.
model SubscriptionEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  /// What changed: "created", "status", "period", "cancel", "price", "failure"; see `lib/billing/`.
  kind           String
  /// The values before and after, as short text ("active", "2026-11-08").
  before         String?
  after          String?
  /// "webhook", "reconcile" or "admin" (`HistorySource` in `lib/billing/sync.ts`).
  source         String
  /// The Stripe event that brought the change, when one did.
  eventId        String?
  at             DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, at])
}

/// Usage counts for the admin stats page (G-075 M4): one row per generation or export job, written
/// best-effort from the Route Handlers that already front the processor. No photo bytes, no export
/// content — a count is all the admin page needs.
model UsageEvent {
  id         String    @id @default(cuid())
  kind       UsageKind
  userId     String?
  /// What an export was (`ExportJobKind`: "a4-color", "all", ...); null for a generation, and for an export recorded
  /// before G-107 M2 began keeping it.
  exportKind String?
  createdAt  DateTime  @default(now())

  @@index([kind, createdAt])
  @@index([userId, createdAt])
  /// The quota's read (G-109): one person's uses of one action in the period that ends now.
  @@index([userId, kind, createdAt])
}

enum UsageKind {
  GENERATE
  EXPORT
}

/// Every change an admin makes (G-102 M3; role and login changes too since G-107 M3, D348): who, when, what.
/// Append-only; the admin's Change log shows it, and the Features page its feature changes.
model FeatureChange {
  id        String   @id @default(cuid())
  /// SITE, USER, SET, TIER or AUDIENCE for the switches; ACCOUNT for a role or a login (`lib/admin/change-log.ts`).
  scope     String
  /// The user id, the set id or the tier id the change was to; empty for the site.
  subject   String   @default("")
  /// What is now true, in words: "tool.text → locked", "set Starter attached".
  change    String
  byUserId  String
  byEmail   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([scope, createdAt])
}

/// A limit's value for one layer (G-108 M1, D353): the limit is an entry of `ACCOUNT_LIMITS` in `lib/limits/limits.ts`, and
/// `value` is a whole number in its unit, null for unlimited. No row means the layer sets nothing and the one below wins:
/// person > tier > guests or accounts > site > the list's default.
model SiteLimit {
  limitId   String   @id
  value     Int?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// A site setting the admin has set (G-126 M1, D374): the setting is an entry of `SITE_SETTINGS` in
/// `lib/settings/site-settings.ts`, and `value` a whole number in its unit. No row means the setting's default.
model SiteSetting {
  key       String   @id
  value     Int
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// "guests" or "accounts", as `AudienceSet.audience`.
model AudienceLimit {
  audience  String
  limitId   String
  value     Int?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@id([audience, limitId])
}

model TierLimit {
  tierId    String
  limitId   String
  value     Int?
  updatedAt DateTime @updatedAt
  updatedBy String?

  tier Tier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@id([tierId, limitId])
}

model UserLimit {
  userId    String
  limitId   String
  value     Int?
  updatedAt DateTime @updatedAt
  updatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, limitId])
}

/// A chart saved to an account (G-108 part 1, D354): the editable file, photo included, kept whole. The id is the
/// server's; the name is only shown, so a renamed chart saved again is the same chart. Private to its owner
/// (`lib/charts/access.ts`), and deleted with the account.
model SavedChart {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// The editable JSON as the editor writes it (`serializePattern`).
  document  String
  /// The document's size in UTF-8, counted against the owner's space (`storage.charts`).
  bytes     Int
  width     Int
  height    Int
  colors    Int
  /// The thread brand every colour is from (`StitchPattern.threadBrand`), or null for a mix or custom colours.
  brand     String?
  /// Kept first in the account's list (M8). Not a save: it changes neither the version nor the save time.
  pinned    Boolean  @default(false)
  /// The chart in its own colours, as a PNG drawn by the server at every save (D357, D362). Null for a chart saved before
  /// previews or before the current drawing, until it is first asked for.
  preview   Bytes?
  /// 1 when made, one more at every overwrite or rename: a save names the version it last saw (Owner, 2026-10-06).
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/// A stamp (G-119, D360): a piece saved from a chart to be placed in others. Kept as an editable chart document of the
/// piece alone, with its shape (`stampMask`), read by the reader the editor opens files with (`lib/stamps/stamp.ts`).
/// Private to its owner, counted against `stamps.count`, and deleted with the account.
model Stamp {
  id         String   @id @default(cuid())
  userId     String
  name       String
  /// The piece as an editable chart document, its threads only those it uses.
  document   String
  bytes      Int
  width      Int
  height     Int
  colors     Int
  /// The threads' colours as #rrggbb, in the stamp's palette order, for the swatches of a card.
  swatches   String[]
  /// True when the piece carries backstitch lines.
  backstitch Boolean  @default(false)
  /// Kept first in the gallery and the account's list. Not a change: the version stays.
  pinned     Boolean  @default(false)
  /// The piece in its own colours, drawn by the server when saved. Null for one kept before the current drawing, until
  /// it is first asked for (D362).
  preview    Bytes?
  /// 1 when made, one more at every rename.
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/// A version of a document the site publishes (G-128 M1, D383): the terms, the privacy policy, or the withdrawal
/// acknowledgment a buyer agrees to. Written by an admin; a published version is never changed, a new one takes its
/// place, so a buyer's consent names the exact text they read.
model LegalVersion {
  id          String   @id @default(cuid())
  /// "terms", "privacy" or "withdrawal" (`lib/legal/documents.ts`).
  kind        String
  /// 1 for a kind's first, one more for each after it.
  version     Int
  /// Markdown, drawn with raw HTML escaped (`renderMarkdown`'s `authored`).
  body        String
  publishedAt DateTime @default(now())
  /// The admin's address, as the Change log names them.
  publishedBy String

  termsConsents      PurchaseConsent[] @relation("consentTerms")
  withdrawalConsents PurchaseConsent[] @relation("consentWithdrawal")

  @@unique([kind, version])
}

/// A buyer's agreement before Checkout (G-128 M2, D384): the terms version they agreed to and the withdrawal
/// acknowledgment they gave, recorded before Stripe is asked, and tied to the subscription the webhook then brings.
/// Personal data: deleted with the account. One left unlinked (Checkout abandoned) is pruned after two days.
model PurchaseConsent {
  id                  String   @id @default(cuid())
  userId              String
  /// The price chosen; a plain id, as the price may be deleted later while the record stays.
  priceId             String
  termsVersionId      String
  withdrawalVersionId String
  /// Set when the subscription the Checkout made is first synced; null until then.
  subscriptionId      String?
  createdAt           DateTime @default(now())

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion      LegalVersion  @relation("consentTerms", fields: [termsVersionId], references: [id])
  withdrawalVersion LegalVersion  @relation("consentWithdrawal", fields: [withdrawalVersionId], references: [id])
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([createdAt])
}
